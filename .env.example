# Copy to .env.local. These settings are public and included in the browser build.
# ONLY an origin-restricted Salling Frontend / Website App key belongs here.
# Never enter a personal, back-end, GitHub or Hugging Face token.
SALLING_KEY_KIND=frontend
SALLING_FRONTEND_KEY=
# Public URL only. HF tokens and Cloudflare credentials never belong in browser config.
RECIPE_ENDPOINT=
