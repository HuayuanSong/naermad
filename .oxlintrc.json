{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint"],
  "categories": { "correctness": "error" },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "error",
    "no-control-regex": "error"
  },
  "env": { "builtin": true, "browser": false, "node": false, "worker": false },
  "ignorePatterns": [
    "dist/**",
    ".wrangler/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "overrides": [
    { "files": ["src/**/*.js"], "env": { "browser": true } },
    { "files": ["generation/**/*.js"], "env": { "worker": true } },
    {
      "files": [
        "vite.config.js",
        "playwright.config.js",
        "scripts/**/*.mjs",
        "tests/**/*.mjs"
      ],
      "env": { "node": true }
    },
    {
      "files": ["tests/browser/**/*.js"],
      "env": { "node": true, "browser": true }
    }
  ]
}
